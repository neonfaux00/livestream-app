@model IEnumerable<LivestreamApp.Models.StreamModel>
@{ ViewData["Title"] = "Browse Streams"; }
<section class="section page-section"><div class="section-title"><div><span class="eyebrow">EXPLORE</span><h1>Browse streams</h1></div></div><form class="search-form" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search creators or streams..."><button class="button primary" type="submit">Search</button></form><div class="stream-grid">@foreach (var stream in Model) { <partial name="_StreamCard" model="stream" /> }</div></section>
