@model LivestreamApp.Models.StreamModel
@{ ViewData["Title"] = Model.Title; }
<section class="watch-layout page-section"><div><div class="video-placeholder"><div class="play">▶</div><span>Stream player placeholder</span><small>Connect an authorized HLS/MP4 source here.</small></div><div class="watch-heading"><div><span class="eyebrow">● LIVE · @Model.Category</span><h1>@Model.Title</h1><p>Streaming by <strong>@Model.Creator</strong> · @Model.Viewers.ToString("N0") viewers</p></div><button class="button primary" onclick="followChannel(this)">Follow</button></div></div><aside class="chat-panel"><h3>Live chat</h3><div class="chat-messages"><p><b>Alex:</b> This is awesome!</p><p><b>Sam:</b> Welcome everyone 👋</p><p><b>Jordan:</b> Let's go!</p></div><form onsubmit="sendChat(event)"><input id="chatInput" placeholder="Send a message..."><button type="submit">↑</button></form></aside></section>
